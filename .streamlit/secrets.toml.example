# Template secrets untuk Streamlit Community Cloud.
#
# Cara pakai:
#   1. Buka https://share.streamlit.io → app kamu → Settings → Secrets
#   2. Paste isi file ini, ganti nilainya dengan yang asli
#   3. Save → app auto-restart
#
# File `.streamlit/secrets.toml` (tanpa .example) SUDAH ada di .gitignore.
# JANGAN pernah commit file yang berisi nilai asli.

# --- Password gerbang dashboard ---
APP_PASSWORD = "ganti-dengan-password-kamu"

# --- Database (Supabase → Project Settings → Database → Connection string → URI) ---
# Pakai "Connection pooling / Session pooler" kalau tersedia (port 5432 atau 6543).
# Tambahkan ?sslmode=require di akhir.
DATABASE_URL = "postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Engine mapping (biarkan 'rules' = deterministik, tanpa LLM) ---
HERMES_ENGINE = "rules"
HERMES_PROMPT_TIMEOUT = "30"
